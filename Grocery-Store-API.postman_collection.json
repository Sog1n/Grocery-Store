{
	"info": {
		"_postman_id": "grocery-store-api-collection",
		"name": "Grocery Store API",
		"description": "Complete API collection for Grocery Store project with automated tests and monitoring scripts. Includes Pre-request Scripts and Test Scripts for all endpoints.",
